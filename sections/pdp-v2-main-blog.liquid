{%- paginate blog.articles by 12 -%}
<div class="pdp-v2">
  <div style="padding:32px 20px;font-family:'DM Sans',sans-serif;max-width:720px;margin:0 auto">
    <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;margin:0 0 20px">{{ blog.title }}</h1>
    <div style="display:flex;flex-direction:column;gap:20px">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" style="text-decoration:none;color:#111111;border-bottom:1px solid #EFEAE3;padding-bottom:16px">
          <div style="font-size:16px;font-weight:500">{{ article.title }}</div>
          <div style="font-size:12px;color:#8B8479;margin-top:4px">{{ article.published_at | date: '%B %d, %Y' }}</div>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div style="display:flex;gap:10px;justify-content:center;margin-top:32px;font-size:13px">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "PDP v2 — Blog list" }
{% endschema %}
