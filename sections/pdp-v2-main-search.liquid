<div class="pdp-v2">
  <div style="padding:32px 20px;font-family:'DM Sans',sans-serif">
    <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;margin:0 0 8px">Search</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" style="display:flex;margin-bottom:24px;max-width:420px">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search" style="flex:1;border:1px solid #DDD9D3;padding:12px;font-size:13px">
      <button type="submit" style="background:#111111;color:#FDFCF9;border:none;padding:0 20px;font-size:12px;letter-spacing:0.1em">Search</button>
    </form>
    {%- if search.performed -%}
      <p style="font-size:13px;color:#66615B;margin-bottom:20px">{{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
        {%- for item in search.results -%}
          <a href="{{ item.url }}" style="text-decoration:none;color:#111111;display:flex;flex-direction:column;gap:8px">
            <span style="aspect-ratio:1;background:#F1ECE5;display:block;overflow:hidden">
              {%- if item.featured_image != blank -%}{{ item.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: item.title, style: 'width:100%;height:100%;object-fit:cover' }}{%- endif -%}
            </span>
            <span style="font-size:13px">{{ item.title }}</span>
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{ "name": "PDP v2 — Search" }
{% endschema %}
