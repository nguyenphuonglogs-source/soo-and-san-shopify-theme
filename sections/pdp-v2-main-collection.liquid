{%- paginate collection.products by 24 -%}
<div class="pdp-v2">
  <div style="padding:32px 20px;font-family:'DM Sans',sans-serif">
    <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;margin:0 0 20px">{{ collection.title }}</h1>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
      {%- for product in collection.products -%}
        <a href="{{ product.url }}" style="text-decoration:none;color:#111111;display:flex;flex-direction:column;gap:8px">
          <span style="aspect-ratio:1;background:#F1ECE5;display:block;overflow:hidden">
            {%- if product.featured_image != blank -%}
              {{ product.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: product.title, style: 'width:100%;height:100%;object-fit:cover' }}
            {%- endif -%}
          </span>
          <span style="font-size:13px">{{ product.title }}</span>
          <span style="font-size:13px;font-weight:500">{{ product.price | money }}</span>
        </a>
      {%- else -%}
        <p style="font-size:13px;color:#66615B">No products in this collection yet.</p>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div style="display:flex;gap:10px;justify-content:center;margin-top:32px;font-size:13px">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">Previous</a>{%- endif -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}">Next</a>{%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>
{%- endpaginate -%}

{% schema %}
{ "name": "PDP v2 — Collection grid" }
{% endschema %}
