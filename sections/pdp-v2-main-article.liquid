<div class="pdp-v2">
  <div style="padding:32px 20px;font-family:'DM Sans',sans-serif;max-width:720px;margin:0 auto">
    <div style="font-size:12px;color:#8B8479;margin-bottom:6px">{{ article.published_at | date: '%B %d, %Y' }}</div>
    <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;margin:0 0 20px">{{ article.title }}</h1>
    <div style="font-size:14px;line-height:1.7;color:#3A3733">{{ article.content }}</div>
  </div>
</div>

{% schema %}
{ "name": "PDP v2 — Article" }
{% endschema %}
