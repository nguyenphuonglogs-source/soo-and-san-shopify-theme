<div class="pdp-v2">
  <div class="pdp-v2__press">
    <div class="pdp-v2__press-title">{{ section.settings.heading | default: 'As seen on' | upcase }}</div>
    <div class="pdp-v2__marquee">
      <div class="pdp-v2__marquee-track">
        {%- for i in (1..2) -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'logo' -%}
              <div class="pdp-v2__press-logo" {% if i == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
                {%- if block.settings.image != blank -%}
                  {{ block.settings.image | image_url: width: 300 | image_tag: loading: 'lazy', alt: block.settings.name }}
                {%- else -%}
                  {{ block.settings.name | default: 'PRESS LOGO' }}
                {%- endif -%}
              </div>
            {%- endif -%}
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
    <div class="pdp-v2__press-note pdp-v2__show-desktop">Auto-scrolling marquee, paused on hover · logos supplied as SVG</div>
  </div>
</div>

{% schema %}
{
  "name": "PDP v2 — As seen on",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "As seen on" }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Press logo",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Logo (SVG/PNG)" },
        { "type": "text", "id": "name", "label": "Fallback label", "default": "PRESS LOGO" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "logo" }, { "type": "logo" }, { "type": "logo" }, { "type": "logo" },
      { "type": "logo" }, { "type": "logo" }, { "type": "logo" }
    ]
  }
}
{% endschema %}
