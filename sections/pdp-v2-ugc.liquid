<div class="pdp-v2">
  <div class="pdp-v2__ugc">
    <div class="pdp-v2__ugc-title">{{ section.settings.heading | default: 'YOU + @SOOANDSAN' }}</div>
    <div class="pdp-v2__ugc-row">
      {%- for block in section.blocks -%}
        {%- if block.type == 'image' -%}
          <div class="pdp-v2__ugc-item{% if block.settings.image == blank %} pdp-v2__stripe--tight{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: loading: 'lazy', alt: block.settings.caption }}
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PDP v2 — UGC grid",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "YOU + @SOOANDSAN" }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "caption", "label": "Alt text / placeholder caption" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "image", "settings": { "caption": "customer wall" } },
      { "type": "image", "settings": { "caption": "gift moment" } },
      { "type": "image", "settings": { "caption": "family" } },
      { "type": "image", "settings": { "caption": "couple" } },
      { "type": "image", "settings": { "caption": "kids" } }
    ]
  }
}
{% endschema %}
