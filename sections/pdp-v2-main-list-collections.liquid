<div class="pdp-v2">
  <div style="padding:32px 20px;font-family:'DM Sans',sans-serif">
    <h1 style="font-family:'Newsreader',serif;font-weight:400;font-size:28px;margin:0 0 20px">Collections</h1>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:20px">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" style="text-decoration:none;color:#111111;display:flex;flex-direction:column;gap:8px">
          <span style="aspect-ratio:1;background:#F1ECE5;display:block;overflow:hidden">
            {%- if collection.featured_image != blank -%}{{ collection.featured_image | image_url: width: 500 | image_tag: loading: 'lazy', alt: collection.title, style: 'width:100%;height:100%;object-fit:cover' }}{%- endif -%}
          </span>
          <span style="font-size:13px">{{ collection.title }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{ "name": "PDP v2 — Collection list" }
{% endschema %}
